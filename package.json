{
  "name": "dsh-task-folding",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: wrap work in tasks and fold finished tasks into model-written summaries, with lossless recall.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hametovbr/dsh-task-folding.git"
  },
  "homepage": "https://github.com/hametovbr/dsh-task-folding#readme",
  "bugs": {
    "url": "https://github.com/hametovbr/dsh-task-folding/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "summarization"
  ],
  "type": "module",
  "main": "./host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./package.json": "./package.json",
    "./client": "./client/module.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22.8"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "contract": "node scripts/contract-check.js",
    "pack:check": "node scripts/check-pack.js",
    "e2e": "node scripts/e2e-headless.js",
    "probe:advisor": "node scripts/advisor-compat-probe.mjs",
    "prepublishOnly": "node scripts/release-check.js",
    "locale:gen": "node scripts/gen-locale.js",
    "coverage": "node --test --experimental-test-coverage \"--test-coverage-include=host/**/*.js\" --test-coverage-branches=85 --test-coverage-lines=90 --test-coverage-functions=80 \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "perf": "node --test test/perf.manual.js",
    "mutation": "node scripts/mutate.js --min-score 0.85",
    "release:check": "node scripts/release-check.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
