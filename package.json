{
  "name": "dsh-task-folding",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeek Harness plugin: wrap work in tasks and fold finished tasks into model-written summaries, with lossless recall.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=host/projection.js --test-coverage-include=host/cuts.js --test-coverage-branches=100 --test-coverage-lines=100 --test-coverage-functions=100 \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
